{
  "manifest_version": 3,
  "name": "mailCode",
  "version": "0.2.0",
  "description": "Find Gmail verification codes and fill website verification fields",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "clipboardWrite",
    "webRequest",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "mailCode",
    "default_icon": {
      "128": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
